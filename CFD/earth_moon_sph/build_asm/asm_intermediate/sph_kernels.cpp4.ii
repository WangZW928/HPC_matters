{

  thrust::detail::wrapped_function<Predicate, bool> wrapped_pred(pred);

  for (; first != last; ++first, ++stencil)
  {
    if (wrapped_pred(*stencil))
    {
      *out_true = *first;
      ++out_true;
    }
    else
