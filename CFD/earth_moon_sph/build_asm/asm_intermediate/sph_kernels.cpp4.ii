template <class T>
struct constant_f
{
  T value;

  __attribute__((host)) __attribute__((device)) __inline__ __attribute__((always_inline))
  constant_f(T const& x)
      : value(x)
  {}

  template <class U>
  __attribute__((device)) __inline__ __attribute__((always_inline)) T operator()(U const&) const
  {
    return value;
  }
};

template <class Predicate, class NewType, class OutputType>
struct new_value_if_f
{
  Predicate pred;
  NewType new_value;

  __attribute__((host)) __attribute__((device)) __inline__ __attribute__((always_inline))
  new_value_if_f(Predicate pred_, NewType new_value_)
      : pred(pred_)
      , new_value(new_value_)
  {}

  template <class T>
  OutputType __attribute__((device)) __inline__ __attribute__((always_inline)) operator()(T const& x)
  {
    return pred(x) ? new_value : x;
  }

  template <class T, class P>
  OutputType __attribute__((device)) __inline__ __attribute__((always_inline)) operator()(T const& x, P const& y)
  {
    return pred(y) ? new_value : x;
  }
};

