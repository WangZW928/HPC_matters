  int wid = linear_tid >> (5);
  int warp_offset = wid * (1 << (5)) * ITEMS_PER_THREAD;


#pragma unroll
  for (int ITEM = 0; ITEM < ITEMS_PER_THREAD; ITEM++)
  {
    new (&items[ITEM]) InputT(block_itr[warp_offset + tid + (ITEM * (1 << (5)))]);
  }
