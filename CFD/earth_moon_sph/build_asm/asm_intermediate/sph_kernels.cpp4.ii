template <typename T, int LOGICAL_WARP_THREADS, int LEGACY_PTX_ARCH = 0>
struct WarpReduceShfl
{
  static_assert(PowerOfTwo<LOGICAL_WARP_THREADS>::VALUE, "LOGICAL_WARP_THREADS must be a power of two");





  enum
  {

    IS_ARCH_WARP = (LOGICAL_WARP_THREADS == (1 << (5))),


    STEPS = Log2<LOGICAL_WARP_THREADS>::VALUE,


    LOGICAL_WARPS = (1 << (5)) / LOGICAL_WARP_THREADS,


    SHFL_C = ((1 << (5)) - LOGICAL_WARP_THREADS) << 8

  };

  template <typename S>
  struct IsInteger
  {
    enum
    {


      IS_SMALL_UNSIGNED = (Traits<S>::CATEGORY == UNSIGNED_INTEGER) && (sizeof(S) <= sizeof(unsigned int))
    };
  };


  typedef NullType TempStorage;






  int lane_id;


  int warp_id;


  ::cuda::std::uint32_t member_mask;






  __attribute__((device)) __inline__ __attribute__((always_inline)) WarpReduceShfl(TempStorage& )
      : lane_id(static_cast<int>(LaneId()))
      , warp_id(IS_ARCH_WARP ? 0 : (lane_id / LOGICAL_WARP_THREADS))
      , member_mask(WarpMask<LOGICAL_WARP_THREADS>(warp_id))
  {
    if (!IS_ARCH_WARP)
    {
      lane_id = lane_id % LOGICAL_WARP_THREADS;
    }
  }
