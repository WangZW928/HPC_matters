template <typename Derived, typename InputIt, typename StencilIt, typename OutputIt, typename Predicate>
__attribute__((host)) __attribute__((device)) OutputIt copy_if(
  execution_policy<Derived>& policy,
  InputIt first,
  InputIt last,
  StencilIt stencil,
  OutputIt output,
  Predicate predicate)
{
