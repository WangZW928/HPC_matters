                           tuning::load_algorithm,
                           LOAD_DEFAULT,
                           BLOCK_SCAN_WARP_SCANS,
                           tuning::store_algorithm,
                           typename tuning::delay_constructor>;
  };

  using MaxPolicy = Policy900;
};

} }
