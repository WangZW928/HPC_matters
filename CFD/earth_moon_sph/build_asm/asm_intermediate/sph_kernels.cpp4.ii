template <class ValueType, class InputIt, class UnaryOp>
struct transform_input_iterator_t
{
  typedef transform_input_iterator_t self_t;
  typedef typename iterator_traits<InputIt>::difference_type difference_type;
  typedef ValueType value_type;
  typedef void pointer;
  typedef value_type reference;
  typedef std::random_access_iterator_tag iterator_category;

  InputIt input;
  mutable UnaryOp op;

  __attribute__((host)) __attribute__((device)) __inline__ __attribute__((always_inline)) transform_input_iterator_t(InputIt input, UnaryOp op)
      : input(input)
      , op(op)
  {}

  transform_input_iterator_t(const self_t&) = default;



  __attribute__((host)) __attribute__((device)) self_t& operator=(const self_t& o)
  {
    input = o.input;
    return *this;
  }


  __attribute__((host)) __attribute__((device)) __inline__ __attribute__((always_inline)) self_t operator++(int)
  {
    self_t retval = *this;
    ++input;
    return retval;
  }


  __attribute__((host)) __attribute__((device)) __inline__ __attribute__((always_inline)) self_t operator++()
  {
    ++input;
    return *this;
  }


  __attribute__((host)) __attribute__((device)) __inline__ __attribute__((always_inline)) reference operator*() const
  {
    typename thrust::iterator_value<InputIt>::type x = *input;
    return op(x);
  }

  __attribute__((host)) __attribute__((device)) __inline__ __attribute__((always_inline)) reference operator*()
  {
    typename thrust::iterator_value<InputIt>::type x = *input;
    return op(x);
  }


  __attribute__((host)) __attribute__((device)) __inline__ __attribute__((always_inline)) self_t operator+(difference_type n) const
  {
    return self_t(input + n, op);
  }


  __attribute__((host)) __attribute__((device)) __inline__ __attribute__((always_inline)) self_t& operator+=(difference_type n)
  {
    input += n;
    return *this;
  }


  __attribute__((host)) __attribute__((device)) __inline__ __attribute__((always_inline)) self_t operator-(difference_type n) const
  {
    return self_t(input - n, op);
  }


  __attribute__((host)) __attribute__((device)) __inline__ __attribute__((always_inline)) self_t& operator-=(difference_type n)
  {
    input -= n;
    return *this;
  }


  __attribute__((host)) __attribute__((device)) __inline__ __attribute__((always_inline)) difference_type operator-(self_t other) const
  {
    return input - other.input;
  }


  __attribute__((host)) __attribute__((device)) __inline__ __attribute__((always_inline)) reference operator[](difference_type n) const
  {
    return op(input[n]);
  }


  __attribute__((host)) __attribute__((device)) __inline__ __attribute__((always_inline)) bool operator==(const self_t& rhs) const
  {
    return (input == rhs.input);
  }


  __attribute__((host)) __attribute__((device)) __inline__ __attribute__((always_inline)) bool operator!=(const self_t& rhs) const
  {
    return (input != rhs.input);
  }
};

