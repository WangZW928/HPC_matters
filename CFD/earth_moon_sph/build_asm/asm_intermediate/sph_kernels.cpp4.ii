template <typename Derived, typename InputIt, typename Size, typename T, typename BinaryOp>
__attribute__((host)) __attribute__((device)) T
reduce(execution_policy<Derived>& policy, InputIt first, Size num_items, T init, BinaryOp binary_op)
{
  if (num_items == 0)
  {
    return init;
  }

  size_t temp_storage_bytes = 0;
  cudaStream_t stream = cuda_cub::stream(policy);

  cudaError_t status;
  status = doit_step(__null, temp_storage_bytes, first, num_items, init, binary_op, reinterpret_cast<T*>(__null), stream);
