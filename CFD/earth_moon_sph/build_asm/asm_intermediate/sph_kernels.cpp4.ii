template <int LOGICAL_WARP_THREADS, int LEGACY_PTX_ARCH = 0>
__attribute__((host)) __attribute__((device)) __inline__ __attribute__((always_inline)) unsigned int WarpMask(unsigned int warp_id)
{
  constexpr bool is_pow_of_two = PowerOfTwo<LOGICAL_WARP_THREADS>::VALUE;
  constexpr bool is_arch_warp = LOGICAL_WARP_THREADS == (1 << (5));

  unsigned int member_mask = 0xFFFFFFFFu >> ((1 << (5)) - LOGICAL_WARP_THREADS);

  if constexpr (is_pow_of_two && !is_arch_warp)
