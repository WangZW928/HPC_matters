  };

  typedef PtxPolicy<512, ITEMS_PER_THREAD, cub::BLOCK_LOAD_WARP_TRANSPOSE, cub::LOAD_LDG, cub::BLOCK_STORE_WARP_TRANSPOSE>
    type;
};

template <class TSize>
struct Tuning<sm35, TSize> : Tuning<sm30, TSize>
{
