 namespace thrust { inline namespace THRUST_200500_750_890_NS {

namespace cuda_cub
{
namespace launcher
{

struct __attribute__((__visibility__("hidden"))) triple_chevron
{
  typedef size_t Size;
  dim3 const grid;
  dim3 const block;
  Size const shared_mem;
  cudaStream_t const stream;

  __attribute__((host)) __attribute__((device)) triple_chevron(dim3 grid_, dim3 block_, Size shared_mem_ = 0, cudaStream_t stream_ = 0)
      : grid(grid_)
      , block(block_)
      , shared_mem(shared_mem_)
      , stream(stream_)
  {}

  template <class K, class... Args>
  cudaError_t __attribute__((host)) doit_host(K k, Args const&... args) const
  {
    k<<<grid, block, shared_mem, stream>>>(args...);
    return cudaPeekAtLastError();
  }

  template <class T>
  size_t __attribute__((device)) align_up(size_t offset) const
  {
    size_t alignment = alignment_of<T>::value;
    return alignment * ((offset + (alignment - 1)) / alignment);
  }

  size_t __attribute__((device)) argument_pack_size(size_t size) const
  {
    return size;
  }
  template <class Arg, class... Args>
  size_t __attribute__((device)) argument_pack_size(size_t size, Arg const& arg, Args const&... args) const
  {
    size = align_up<Arg>(size);
    return argument_pack_size(size + sizeof(Arg), args...);
  }

  template <class Arg>
  size_t __attribute__((device)) copy_arg(char* buffer, size_t offset, Arg arg) const
  {
    offset = align_up<Arg>(offset);
    for (int i = 0; i != sizeof(Arg); ++i)
    {
      buffer[offset + i] = *((char*) &arg + i);
    }
    return offset + sizeof(Arg);
  }

  __attribute__((device)) void fill_arguments(char*, size_t) const {}

  template <class Arg, class... Args>
  __attribute__((device)) void fill_arguments(char* buffer, size_t offset, Arg const& arg, Args const&... args) const
  {
    fill_arguments(buffer, copy_arg(buffer, offset, arg), args...);
  }


  template <class K, class... Args>
  cudaError_t __attribute__((device)) doit_device(K k, Args const&... args) const
  {
    const size_t size = argument_pack_size(0, args...);
    void* param_buffer = cudaGetParameterBuffer(64, size);
    fill_arguments((char*) param_buffer, 0, args...);
    return launch_device(k, param_buffer);
  }

  template <class K>
  cudaError_t __attribute__((device)) launch_device(K k, void* buffer) const
  {
    return cudaLaunchDevice((void*) k, buffer, dim3(grid), dim3(block), shared_mem, stream);
  }
