template <typename InputT, int ITEMS_PER_THREAD, int LOGICAL_WARP_THREADS = (1 << (5))>
class WarpExchangeShfl
{
  static_assert(PowerOfTwo<LOGICAL_WARP_THREADS>::VALUE, "LOGICAL_WARP_THREADS must be a power of two");

