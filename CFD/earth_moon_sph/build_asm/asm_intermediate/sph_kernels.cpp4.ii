template <typename T>
struct DoubleBuffer
{

  T* d_buffers[2];


  int selector;


  __attribute__((host)) __attribute__((device)) __inline__ __attribute__((always_inline)) DoubleBuffer()
  {
    selector = 0;
    d_buffers[0] = __null;
    d_buffers[1] = __null;
  }


  __attribute__((host)) __attribute__((device)) __inline__ __attribute__((always_inline)) DoubleBuffer(T* d_current,
                                                   T* d_alternate)

  {
    selector = 0;
    d_buffers[0] = d_current;
    d_buffers[1] = d_alternate;
  }


  __attribute__((host)) __attribute__((device)) __inline__ __attribute__((always_inline)) T* Current()
  {
    return d_buffers[selector];
  }


  __attribute__((host)) __attribute__((device)) __inline__ __attribute__((always_inline)) T* Alternate()
  {
    return d_buffers[selector ^ 1];
  }
};
