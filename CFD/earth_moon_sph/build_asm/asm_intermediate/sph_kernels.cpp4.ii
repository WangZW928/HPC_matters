template <class Iterator, class T>
struct functor
{
  Iterator it;
  T value;

  __attribute__((host)) __attribute__((device)) __inline__ __attribute__((always_inline))
  functor(Iterator it, T value)
      : it(it)
      , value(value)
  {}

  template <class Size>
  __attribute__((device)) __inline__ __attribute__((always_inline)) void operator()(Size idx)
  {
    it[idx] = value;
  }
};

}

template <class Derived, class OutputIterator, class Size, class T>
OutputIterator __attribute__((host)) __attribute__((device))
fill_n(execution_policy<Derived>& policy, OutputIterator first, Size count, const T& value)
{
