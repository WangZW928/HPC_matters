# C5.1 must reject mapped inflow/outflow until its physical profile and pressure datum are proven.
avwis.mode = solve
avwis.coordinates = mapped
avwis.mapping.type = analytic_orthogonal
avwis.mapping.scale = 1.2 0.85 1.1
avwis.mapping.stretch = 0.35 -0.25 0.2
avwis.projection.operator = orthogonal_mlmg
avwis.n_cell = 8 8 8
avwis.max_grid_size = 4
avwis.nghost = 2
avwis.is_periodic = 0 0 0
avwis.run_steps = 0

avwisbcs.enabled = 1
avwisbcs.geometry = mapped_orthogonal
avwisbcs.lo = inflow noslip noslip
avwisbcs.hi = outflow noslip noslip
