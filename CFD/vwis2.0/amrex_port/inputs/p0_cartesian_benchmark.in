# P0-004/P0-005 repeatable manufactured Cartesian benchmark.
# This is a contract baseline, not a legacy vwis reference case.
vwis.n_cell = 16 8 8
vwis.max_grid_size = 4
vwis.nghost = 2
vwis.is_periodic = 1 1 1
vwis.dt = 1.0e-3
vwis.run_steps = 8
vwis.viscosity = 0.1
vwis.run_cartesian_benchmark = 1
