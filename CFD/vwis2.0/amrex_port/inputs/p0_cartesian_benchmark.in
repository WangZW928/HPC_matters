# P0-004/P0-005 repeatable manufactured Cartesian benchmark.
# This is a contract baseline, not a legacy vwis reference case.
avwis.mode = benchmark_cartesian
avwis.n_cell = 16 8 8
avwis.max_grid_size = 4
avwis.nghost = 2
avwis.is_periodic = 1 1 1
avwis.dt = 1.0e-3
avwis.run_steps = 8
avwis.viscosity = 0.1
