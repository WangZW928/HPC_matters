# P2 manufactured contract: typed cell fields, three integrated-volume-flux
# face fields, Cartesian area/volume metadata, unique face sums, transforms,
# derived divergence stencil, and periodic cell/face halos.
avwis.mode = contract_base_p2
avwis.n_cell = 32 24 16
avwis.max_grid_size = 8
avwis.nghost = 2
avwis.dt = 1.0e-3
avwis.is_periodic = 1 1 1
