# P4 singular periodic manufactured projection. The pressure RHS must already
# have zero mean; P4 rejects rather than silently repairs incompatible data.
avwis.mode = contract_p4
avwis.n_cell = 24 16 12
avwis.max_grid_size = 6
avwis.nghost = 2
avwis.dt = 0.125
avwis.projection_time_coefficient = 1.5
avwis.is_periodic = 1 1 1
