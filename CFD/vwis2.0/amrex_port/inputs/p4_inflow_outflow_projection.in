# P4 mixed pressure policy: prescribed x-low inflow and wall fluxes are
# homogeneous Neumann for Phi; fixed-pressure x-high is homogeneous Dirichlet
# for Phi and may receive the projection's normal-flux correction.
vwis.n_cell = 24 16 12
vwis.max_grid_size = 6
vwis.nghost = 2
vwis.dt = 0.125
vwis.projection_time_coefficient = 1.0
vwis.is_periodic = 0 0 0
vwis.run_p4_projection_checks = 1

vwisbcs.enabled = 1
vwisbcs.lo = inflow noslip noslip
vwisbcs.hi = outflow noslip noslip
vwisbcs.inlet_profile = uniform
vwisbcs.inlet_target_flux = 0.75
vwisbcs.pressure = 0.0 2.5 0.0 0.0 0.0 0.0
vwisbcs.constrain_outlet_flux = 1
