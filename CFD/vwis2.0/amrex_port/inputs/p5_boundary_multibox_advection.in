# P5-001 constant through-flow across multiple boxes and physical boundaries.
avwis.mode = contract_p5_advection
avwis.n_cell = 16 8 8
avwis.max_grid_size = 4
avwis.nghost = 2
avwis.is_periodic = 0 0 0
avwis.dt = 1.0e-3

avwisbcs.enabled = 1
avwisbcs.lo = inflow noslip noslip
avwisbcs.hi = outflow noslip noslip
avwisbcs.inlet_profile = uniform
avwisbcs.inlet_target_flux = 1.0
avwisbcs.constrain_outlet_flux = 1
