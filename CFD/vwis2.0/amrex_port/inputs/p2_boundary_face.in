# P2-003/005: non-periodic domain faces use adjacent-cell zero-order
# extrapolation only as an algebraic closure until P3 supplies a physical BC.
# The test also confirms that out-of-domain face ghosts remain unfilled.
vwis.n_cell = 32 24 16
vwis.max_grid_size = 8
vwis.nghost = 2
vwis.dt = 1.0e-3
vwis.is_periodic = 0 0 0
vwis.run_p2_transform_checks = 1
