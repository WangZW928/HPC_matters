# Deliberate P5-003 C5.1 opt-in: all six logical faces are stationary mapped
# no-slip walls. This is analytic separable orthogonal, not general curved BC.
avwis.mode = contract_p5_mapped_boundary
avwis.coordinates = mapped
avwis.mapping.type = analytic_orthogonal
avwis.mapping.scale = 1.2 0.85 1.1
avwis.mapping.stretch = 0.35 -0.25 0.2
avwis.projection.operator = orthogonal_mlmg
avwis.n_cell = 12 10 8
avwis.max_grid_size = 4
avwis.nghost = 2
avwis.is_periodic = 0 0 0
avwis.dt = 1.0e-3
avwis.projection_time_coefficient = 1.0

avwisbcs.enabled = 1
avwisbcs.geometry = mapped_orthogonal
avwisbcs.lo = noslip noslip noslip
avwisbcs.hi = noslip noslip noslip
