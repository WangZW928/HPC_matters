# P4 closed all-Neumann pressure problem. All velocity boundaries are explicit
# no-penetration walls; the compatible RHS is solved with a zero-mean Phi gauge.
avwis.mode = contract_p4
avwis.n_cell = 24 16 12
avwis.max_grid_size = 6
avwis.nghost = 2
avwis.dt = 0.125
avwis.projection_time_coefficient = 1.0
avwis.is_periodic = 0 0 0

avwisbcs.enabled = 1
avwisbcs.lo = noslip noslip noslip
avwisbcs.hi = noslip noslip noslip
