# Short deterministic schema/sanity check. This is not a CFD validation case.
avwis.mode = case_lid_cavity
avwis.n_cell = 8 8 1
avwis.max_grid_size = 4
avwis.nghost = 2
avwis.is_periodic = 0 0 1
avwis.dt = 5.0e-3
avwis.run_steps = 8
avwis.viscosity = 1.0e-2

avwisbcs.enabled = 1
avwisbcs.lo = noslip noslip ""
avwisbcs.hi = noslip moving_wall ""
avwisbcs.moving_wall_velocity = 1.0 0.0 0.0
