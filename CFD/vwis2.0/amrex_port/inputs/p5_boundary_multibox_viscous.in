# P5-002 zero-state diffusion across physical no-slip boundaries and multiple boxes.
avwis.mode = contract_p5_viscous
avwis.n_cell = 16 12 8
avwis.max_grid_size = 4
avwis.nghost = 2
avwis.is_periodic = 0 0 0
avwis.dt = 1.0e-3
avwis.viscosity = 0.125

avwisbcs.enabled = 1
avwisbcs.lo = noslip noslip noslip
avwisbcs.hi = noslip noslip noslip
