# C5.2 closed mapped domain: x is translation-periodic, y has tangential
# moving walls, and z exercises distinct slip and symmetry names.
avwis.mode = contract_p5_mapped_boundary_c52
avwis.coordinates = mapped
avwis.mapping.type = analytic_orthogonal
avwis.mapping.scale = 1.1 0.85 1.2
avwis.mapping.stretch = 0.25 -0.3 0.2
avwis.projection.operator = orthogonal_mlmg
avwis.n_cell = 12 10 8
avwis.max_grid_size = 4
avwis.nghost = 2
avwis.is_periodic = 1 0 0
avwis.dt = 1.0e-3
avwis.projection_time_coefficient = 1.0

avwisbcs.enabled = 1
avwisbcs.geometry = mapped_orthogonal
avwisbcs.lo = "" moving_wall slip
avwisbcs.hi = "" moving_wall symmetry
avwisbcs.moving_wall_velocity = 0.4 0.0 0.0
